{
  "title": "Personal profile frontmatter",
  "type": "object",
  "required": ["id", "staff_id", "type", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^staff:[0-9]{8}$" },
    "staff_id": { "type": "string", "pattern": "^[0-9]{8}$" },
    "type": { "type": "string", "const": "profile" },
    "status": { "type": "string", "enum": ["active", "inactive"] },
    "display_name": { "type": "string" },
    "teams": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
