{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team KB Source Manifest",
  "type": "object",
  "required": ["id", "title", "source_type", "collector", "collected_at", "sensitivity", "hash", "status"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "source_type": {
      "enum": ["interview", "meeting", "incident", "session", "confluence-mirror", "document"]
    },
    "collector": { "type": "string", "pattern": "^staff:[0-9]{8}$" },
    "collected_at": { "type": "string" },
    "sensitivity": { "enum": ["internal", "restricted", "confidential"] },
    "origin": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "hash": { "type": "string" },
    "status": { "enum": ["captured", "ingested", "compiled", "archived"] }
  }
}
