{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team KB Page",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "status",
    "review_state",
    "confidence",
    "visibility",
    "owners",
    "source_refs",
    "related",
    "tags",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "type": {
      "enum": [
        "overview",
        "glossary",
        "concept",
        "team",
        "project",
        "system",
        "practice",
        "runbook",
        "decision",
        "learning",
        "mirrored"
      ]
    },
    "status": {
      "enum": ["draft", "candidate", "active", "stale", "superseded", "archived"]
    },
    "review_state": {
      "enum": ["unreviewed", "reviewed", "needs-review", "disputed"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visibility": {
      "enum": ["internal", "restricted", "confidential"]
    },
    "owners": {
      "type": "array",
      "items": { "type": "string", "pattern": "^staff:[0-9]{8}$" },
      "minItems": 1
    },
    "maintainers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^staff:[0-9]{8}$" }
    },
    "reviewers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^staff:[0-9]{8}$" }
    },
    "knowledge_sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^staff:[0-9]{8}$" }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "related": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verified_at": {
      "type": ["string", "null"]
    },
    "review_after": {
      "type": ["string", "null"]
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_by": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "mirror_provider": { "type": "string" },
    "remote_id": { "type": "string" },
    "remote_url": { "type": "string" },
    "remote_version": { "type": "string" },
    "remote_hash": { "type": "string" },
    "synced_at": { "type": "string" },
    "collector": { "type": "string", "pattern": "^staff:[0-9]{8}$" },
    "mirror_status": { "enum": ["synced", "stale", "failed", "archived"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "mirrored" } },
        "required": ["type"]
      },
      "then": {
        "required": [
          "mirror_provider",
          "remote_id",
          "remote_url",
          "remote_version",
          "remote_hash",
          "synced_at",
          "collector",
          "mirror_status"
        ]
      }
    }
  ]
}
